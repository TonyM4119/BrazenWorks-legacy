/* Dark theme matching the UI concept. Accent: #F0A04B (brass). Selection: #5AA9FF. */
QWidget { background: #1F2226; color: #E6E8EB; font-size: 12px; }
QMainWindow, QStatusBar { background: #16181B; }
QMenuBar { background: #0F1113; }
QMenuBar::item:selected, QMenu::item:selected { background: #2F3A4A; }
QMenu { background: #23262B; border: 1px solid #33373D; }

#Ribbon, #Timeline { background: #1F2226; border-bottom: 1px solid #2A2D32; }
#WorkspaceSwitcher { background: #16181B; border: 1px solid #33373D; border-radius: 6px;
                     padding: 0 14px; font-weight: bold; letter-spacing: 1px; min-width: 150px; }
QTabBar::tab { background: transparent; color: #9AA1AB; padding: 4px 10px; font-weight: bold;
               border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #E6E8EB; border-bottom: 2px solid #F0A04B; }
#ToolGroup { border-right: 1px solid #33373D; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 6px;
              padding: 6px 8px; }
QToolButton:hover { background: #2E3238; }
QToolButton:pressed { border-color: #F0A04B; }
QToolButton:disabled { color: #6B7280; }
#GroupLabel { color: #9AA1AB; font-size: 10px; font-weight: bold; padding: 0; }

QDockWidget::title { background: #23262B; padding: 6px; font-weight: bold; letter-spacing: 1px; }
QTreeWidget, QListWidget { background: #23262B; border: 1px solid #33373D; border-radius: 6px; }
QTreeWidget::item:selected, QListWidget::item:selected { background: #2F3A4A; }
QListWidget::item { padding: 4px 10px; margin: 2px; border: 1px solid #3A3F46; border-radius: 5px;
                    background: #33373D; }
