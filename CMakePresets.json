{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings. The machine-specific 'dev' and 'release' presets live in CMakeUserPresets.json, written by tools/dev-env/setup-*.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Release, system packages)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true } }
  ]
}
